{
  "manifest_version": 3,
  "name": "CleanTab: NSFW Blocker & Focus Mode",
  "short_name": "CleanTab",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "incognito": "split",
  "description": "Pauses explicit pages and closes streaming and endless feeds while you focus. Runs on your device: no account, no server.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/domains.js",
        "shared/keywords.js",
        "shared/thresholds.js",
        "shared/scoring.js",
        "shared/pageshape.js",
        "shared/detect.js",
        "shared/dwell.js",
        "shared/nano.js",
        "shared/focuspage.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "Assets/icon16.png",
      "32": "Assets/icon32.png",
      "48": "Assets/icon48.png",
      "128": "Assets/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "Assets/icon16.png",
    "32": "Assets/icon32.png",
    "48": "Assets/icon48.png",
    "128": "Assets/icon128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
